# ============================================================
# Environment Configuration — AI Document Intelligence System
# ============================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments.
# ============================================================

# --- Required -----------------------------------------------------------

# Your Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# --- Optional (defaults shown) ------------------------------------------

# Groq model to use for answer generation
GROQ_MODEL=openai/gpt-oss-120b

# Sentence-Transformers embedding model
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent storage directory
# CHROMA_PERSIST_DIR=data/chromadb

# ChromaDB collection name
# CHROMA_COLLECTION_NAME=documents

# Text chunking: characters per chunk
# CHUNK_SIZE=500

# Text chunking: character overlap between consecutive chunks
# CHUNK_OVERLAP=50

# Number of top chunks to retrieve per query
# TOP_K=5

# Directory for conversation history JSON files
# CONVERSATION_DIR=data/conversations

# Max recent messages included in prompt context
# MAX_CONVERSATION_HISTORY=10

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Directory for uploaded PDF files
# UPLOAD_DIR=data/uploads
